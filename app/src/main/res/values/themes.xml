<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Tugas_Akhir" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.TugasAkhir.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/Primary_1</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_inset</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.Tugas_Akhir</item>

        <item name="android:statusBarColor">@color/Primary_1</item>
        <item name="android:navigationBarColor">@color/Primary_1</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.TugasAkhir.Cropper" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/Primary_2</item>
        <item name="colorPrimaryDark">@color/Primary_1</item>
        <item name="colorAccent">@color/Primary_2</item>

        <item name="android:statusBarColor">@color/Primary_1</item>
        <item name="android:navigationBarColor">@color/White</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>
</resources>